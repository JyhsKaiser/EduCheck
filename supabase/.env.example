# Copia este archivo a supabase/.env (está en .gitignore) y súbelo con:
#   supabase secrets set --env-file supabase/.env
# Los nombres NO pueden empezar con SUPABASE_ (están reservados).

# ID del proyecto de Firebase (Configuración del proyecto → General)
FIREBASE_PROJECT_ID=tu-proyecto-firebase

# Contenido COMPLETO del JSON de la cuenta de servicio de Firebase, en una sola línea.
# Consola de Firebase → Configuración → Cuentas de servicio → Generar nueva clave privada.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-xxxxx@tu-proyecto.iam.gserviceaccount.com"}

# Clave larga y aleatoria; el MISMO valor se usa en supabase/cron.sql (openssl rand -hex 32)
CRON_SECRET=cambia-esto-por-un-valor-aleatorio

# Zona horaria de los horarios del plantel
TZ_PLANTEL=America/Mexico_City

# Aviso «sin contacto con el dispositivo»: déjalo en false hasta que la app envíe latidos
AVISO_SIN_CONTACTO=false

# Días que se conservan las evidencias antes de borrarlas
RETENCION_DIAS=30

# Solo si tu proyecto no inyecta SUPABASE_SERVICE_ROLE_KEY en las funciones:
# EDUCHECK_SERVICE_KEY=
