rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Perfil del usuario: solo lo lee su dueño. Lo crea el administrador desde la consola
    // (más adelante, el backend con Admin SDK). Los clientes no escriben aquí.
    match /usuarios/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Todo lo demás permanece cerrado hasta definir las reglas de cada módulo.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
