rules_version = '2';

// =====================================================================================
//  EduCheck · Firestore security rules (v1.3, English schema)
//  - The role is read from users/{uid} (each evaluation costs one read). Sprint 1 moves it to
//    a Firebase custom claim set by a Supabase Edge Function; only role() has to change.
//  - The geofence is validated HERE with latlng.distance(): the client cannot register an
//    entry outside the campus radius + tolerance (single campus: config/campus).
//  - Roles: STUDENT, GUARDIAN, TEACHER and ADMIN (ADMIN is also the academic coordinator and
//    covers the prefecture duties: manual attendance, justifications and dashboard).
//  - Push notices, absences and tolerances are resolved by the backend (Supabase Edge
//    Functions with the service account): absences/ and notifications/ are read-only for clients.
// =====================================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Sprint 1: replace with request.auth.token.role (custom claim).
    function hasRole(r) {
      return isSignedIn() && profile().active == true && profile().role == r;
    }

    function isAdmin() {
      return hasRole('ADMIN');
    }

    function onlyChanges(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // The event time (may come from an offline queue) can neither be in the future nor older than 24 h.
    function reasonableTime(t) {
      return t is timestamp &&
        t <= request.time + duration.value(5, 'm') &&
        t >= request.time - duration.value(24, 'h');
    }

    // ---------------------------------------------------------------- users
    // Profile and role. Created by the administrator (the first ADMIN is created by hand in the console;
    // later users are created by the `create-user` Edge Function).
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    // ---------------------------------------------------------------- config
    // Single campus: center (GeoPoint), radiusMeters, toleranceMeters, toleranceMinutes, timeZone, bssids[].
    match /config/campus {
      allow read: if isSignedIn() && profile().active == true;
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------------- devices
    // Device linking (docId = installId generated by the app; it is not the MAC).
    match /devices/{installId} {
      function dd() {
        return request.resource.data;
      }

      allow read: if isSignedIn() && (resource.data.userUid == request.auth.uid || isAdmin());

      // The app requests the link: students start PENDING; other roles start ACTIVE.
      allow create: if isSignedIn()
        && dd().keys().hasOnly(['userUid', 'studentId', 'role', 'status', 'model', 'fcmToken', 'createdAt'])
        && dd().keys().hasAll(['userUid', 'role', 'status', 'createdAt'])
        && dd().userUid == request.auth.uid
        && dd().role == profile().role
        && dd().status == (profile().role == 'STUDENT' ? 'PENDING' : 'ACTIVE')
        && (profile().role != 'STUDENT' ||
            (dd().studentId is string &&
             get(/databases/$(database)/documents/students/$(dd().studentId)).data.studentUid == request.auth.uid))
        && dd().createdAt == request.time;

      // The owner can only refresh the FCM token; the administrator approves, revokes and links.
      allow update: if (isSignedIn()
          && resource.data.userUid == request.auth.uid
          && onlyChanges(['fcmToken'])
          && request.resource.data.fcmToken is string)
        || isAdmin();
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------- students
    // studentUid (nullable): the student's account; guardianUids: their guardians' accounts.
    match /students/{studentId} {
      allow read: if isSignedIn() && (
        resource.data.studentUid == request.auth.uid ||
        request.auth.uid in resource.data.guardianUids ||
        isAdmin());
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------------- presences
    // Daily presence at the campus. docId = {studentId}_{yyyy-MM-dd}  (one per student and day).
    // PRESENT is written from the client. Absence lives in the `absences` collection (written by the backend).
    match /presences/{presenceId} {
      function pd() {
        return request.resource.data;
      }

      function keyOk() {
        return presenceId == pd().studentId + '_' + pd().date;
      }

      function allowedFields() {
        return pd().keys().hasOnly(['studentId', 'studentUid', 'date', 'status', 'method',
          'confidence', 'location', 'bssid', 'entryTime', 'exitTime', 'trustedClock', 'registeredBy',
          'guardianUids', 'deviceId', 'clientUuid', 'createdAt']);
      }

      // The student registers their own entry with an ACTIVE device and inside the geofence.
      function createdByStudent() {
        let s = get(/databases/$(database)/documents/students/$(pd().studentId)).data;
        let c = get(/databases/$(database)/documents/config/campus).data;
        let dev = get(/databases/$(database)/documents/devices/$(pd().deviceId)).data;
        return isSignedIn()
          && pd().keys().hasAll(['studentId', 'studentUid', 'date', 'status', 'method',
               'confidence', 'location', 'entryTime', 'trustedClock', 'guardianUids', 'deviceId',
               'clientUuid', 'createdAt'])
          && s.studentUid == request.auth.uid && s.active == true
          && pd().studentUid == request.auth.uid
          && pd().guardianUids == s.guardianUids
          && pd().status == 'PRESENT'
          && (pd().method == 'GEOFENCE' || pd().method == 'GEOFENCE_WIFI')
          && pd().confidence == (pd().method == 'GEOFENCE_WIFI' ? 1 : 0)
          && pd().location is latlng
          && pd().location.distance(c.center) <= c.radiusMeters + c.toleranceMeters
          && (pd().method == 'GEOFENCE' || (pd().bssid is string && pd().bssid in c.bssids))
          && reasonableTime(pd().entryTime)
          && pd().createdAt == request.time
          && dev.status == 'ACTIVE'
          && dev.studentId == pd().studentId
          && dev.userUid == request.auth.uid;
      }

      // The administrator registers a student without a phone by searching them manually (RF-P01).
      function createdByAdmin() {
        let s = get(/databases/$(database)/documents/students/$(pd().studentId)).data;
        return isAdmin()
          && pd().keys().hasAll(['studentId', 'studentUid', 'date', 'status', 'method',
               'confidence', 'entryTime', 'trustedClock', 'guardianUids', 'registeredBy', 'clientUuid', 'createdAt'])
          && pd().studentUid == s.studentUid
          && pd().guardianUids == s.guardianUids
          && pd().status == 'PRESENT'
          && pd().method == 'ADMIN_MANUAL'
          && pd().confidence == 1
          && pd().registeredBy == request.auth.uid
          && reasonableTime(pd().entryTime)
          && pd().createdAt == request.time;
      }

      allow read: if isSignedIn() && (
        resource.data.studentUid == request.auth.uid ||
        request.auth.uid in resource.data.guardianUids ||
        isAdmin());

      // Only the branch matching the method is evaluated (avoids errors from fields missing in the other one).
      allow create: if (allowedFields() && keyOk() &&
          ((pd().method == 'ADMIN_MANUAL' && createdByAdmin()) ||
           (pd().method != 'ADMIN_MANUAL' && createdByStudent())))
        || isAdmin();

      // The student only registers their exit (can update it, but never backwards).
      allow update: if (isSignedIn()
          && resource.data.studentUid == request.auth.uid
          && onlyChanges(['exitTime'])
          && reasonableTime(request.resource.data.exitTime)
          && request.resource.data.exitTime >
               resource.data.get('exitTime', resource.data.entryTime))
        || isAdmin();

      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------- absences
    // Written by the backend when the tolerance expires (docId = {studentId}_{yyyy-MM-dd}) and deleted if the
    // student registers their entry afterwards. Clients only read.
    match /absences/{absenceId} {
      allow read: if isSignedIn() &&
        (request.auth.uid in resource.data.guardianUids || isAdmin());
      allow write: if false;
    }

    // ---------------------------------------------------------------- justifications
    // The evidence (photo or video) lives in Supabase Storage (private bucket); here only the path:
    // {guardianUid}/{clientUuid}.jpg|mp4
    match /justifications/{justificationId} {
      function dj() {
        return request.resource.data;
      }

      function createdByGuardian() {
        let s = get(/databases/$(database)/documents/students/$(dj().studentId)).data;
        return isSignedIn()
          && dj().keys().hasOnly(['studentId', 'guardianUid', 'type', 'startDate', 'endDate',
               'reason', 'evidencePath', 'evidenceType', 'status', 'clientUuid', 'createdAt'])
          && dj().keys().hasAll(['studentId', 'guardianUid', 'type', 'startDate', 'endDate',
               'reason', 'status', 'clientUuid', 'createdAt'])
          && request.auth.uid in s.guardianUids
          && dj().guardianUid == request.auth.uid
          && dj().type in ['NOTE', 'MEDICAL_CERTIFICATE']
          && dj().status == 'PENDING'
          && dj().reason is string && dj().reason.size() > 0 && dj().reason.size() <= 500
          && dj().createdAt == request.time
          && (!('evidencePath' in dj()) ||
              (dj().evidencePath is string &&
               dj().evidencePath.matches('^' + request.auth.uid + '/[A-Za-z0-9._-]+$')));
      }

      allow read: if isSignedIn() &&
        (resource.data.guardianUid == request.auth.uid || isAdmin());

      allow create: if createdByGuardian();

      // The administrator accepts or rejects (RF-P04).
      allow update: if isAdmin()
        && onlyChanges(['status', 'reviewComment', 'reviewedBy', 'reviewedAt'])
        && request.resource.data.status in ['ACCEPTED', 'REJECTED']
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt == request.time;
    }

    // ---------------------------------------------------------------- academic module
    // Groups: include teacherUids and the student list {id, name, studentNumber} maintained by ADMIN
    // (so the teacher gets their roster with a single read).
    match /groups/{groupId} {
      allow read: if isSignedIn() &&
        (isAdmin() || request.auth.uid in resource.data.teacherUids);
      allow write: if isAdmin();
    }

    match /subjects/{subjectId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Group-subject-teacher assignment.
    match /assignments/{assignmentId} {
      allow read: if isSignedIn() &&
        (resource.data.teacherUid == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // Schedules per subject (RF-AD01): weekday 1-7, startTime/endTime "HH:mm", room.
    match /schedules/{scheduleId} {
      allow read: if isSignedIn() &&
        (resource.data.teacherUid == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // Class session and roll call. docId = {scheduleId}_{yyyy-MM-dd}.
    // roster: { studentId: { status: 'ATTENDED'|'NOT_ATTENDED', justified: bool } }  (one write per roll call)
    match /class_sessions/{classSessionId} {
      function ds() {
        return request.resource.data;
      }

      function createdByTeacher() {
        let h = get(/databases/$(database)/documents/schedules/$(ds().scheduleId)).data;
        return isSignedIn()
          && ds().keys().hasOnly(['scheduleId', 'assignmentId', 'groupId', 'teacherUid', 'date',
               'subjectName', 'groupName', 'startTime', 'endTime', 'status', 'roster', 'createdAt', 'updatedAt'])
          && ds().keys().hasAll(['scheduleId', 'assignmentId', 'groupId', 'teacherUid', 'date',
               'status', 'roster', 'createdAt'])
          && classSessionId == ds().scheduleId + '_' + ds().date
          && h.teacherUid == request.auth.uid
          && ds().teacherUid == request.auth.uid
          && ds().groupId == h.groupId
          && ds().assignmentId == h.assignmentId
          && ds().status in ['OPEN', 'CLOSED']
          && ds().roster is map && ds().roster.size() <= 80
          && ds().createdAt == request.time;
      }

      allow read: if isSignedIn() &&
        (resource.data.teacherUid == request.auth.uid || isAdmin());

      allow create: if createdByTeacher() || isAdmin();

      // The teacher corrects while the session is OPEN; afterwards only ADMIN.
      allow update: if (isSignedIn()
          && resource.data.teacherUid == request.auth.uid
          && resource.data.status == 'OPEN'
          && onlyChanges(['roster', 'status', 'updatedAt'])
          && request.resource.data.roster is map && request.resource.data.roster.size() <= 80
          && request.resource.data.updatedAt == request.time)
        || isAdmin();

      allow delete: if isAdmin();
    }

    // Grades imported from another system (read-only for the app). docId = {assignmentId}_{studentId}
    match /grades/{gradeId} {
      allow read: if isSignedIn() && (resource.data.teacherUid == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------------- emergencies (RF-PF04)
    match /emergencies/{emergencyId} {
      function de() {
        return request.resource.data;
      }

      allow read: if isSignedIn() && (resource.data.teacherUid == request.auth.uid || isAdmin());

      allow create: if hasRole('TEACHER')
        && de().keys().hasOnly(['teacherUid', 'classSessionId', 'message', 'status', 'createdAt'])
        && de().keys().hasAll(['teacherUid', 'message', 'status', 'createdAt'])
        && de().teacherUid == request.auth.uid
        && de().status == 'OPEN'
        && de().message is string && de().message.size() > 0 && de().message.size() <= 500
        && de().createdAt == request.time;

      allow update: if isAdmin()
        && onlyChanges(['status', 'attendedBy', 'attendedAt'])
        && request.resource.data.status == 'ATTENDED'
        && request.resource.data.attendedBy == request.auth.uid
        && request.resource.data.attendedAt == request.time;
    }

    // ---------------------------------------------------------------- notifications
    // In-app inbox. Only the backend writes (the Admin SDK ignores these rules).
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.recipientUid == request.auth.uid;
      allow update: if isSignedIn() && resource.data.recipientUid == request.auth.uid && onlyChanges(['read']);
      allow create, delete: if false;
    }

    // Everything else stays closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
