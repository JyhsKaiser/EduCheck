rules_version = '2';

// =====================================================================================
//  EduCheck · Reglas de seguridad de Firestore (v1.3, etapa 1)
//  - El rol se lee de usuarios/{uid} (cada evaluación cuesta una lectura; más adelante
//    se puede pasar a custom claims con Admin SDK).
//  - La geocerca se valida AQUÍ con latlng.distance(): el cliente no puede registrar
//    una entrada fuera del radio + tolerancia del plantel.
//  - Roles: ALUMNO, TUTOR, PROFESOR y ADMIN (el ADMIN es también el coordinador académico y
//    hace las funciones de prefectura: escáner QR, justificantes y dashboard).
//  - Los avisos push, las ausencias, las tolerancias y el TOTP los resuelve el backend
//    (Supabase Edge Functions con la cuenta de servicio): por eso ausencias/ y notificaciones/
//    son de solo lectura para los clientes.
// =====================================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- utilidades
    function autenticado() {
      return request.auth != null;
    }

    function perfil() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function esRol(r) {
      return autenticado() && perfil().activo == true && perfil().rol == r;
    }

    function esAdmin() {
      return esRol('ADMIN');
    }

    function mismoPlantel(plantelId) {
      return autenticado() && perfil().activo == true && perfil().plantelId == plantelId;
    }

    function soloCambia(campos) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos);
    }

    // La hora del evento (puede venir de una cola offline) no puede ser futura ni tener más de 24 h.
    function horaRazonable(t) {
      return t is timestamp &&
        t <= request.time + duration.value(5, 'm') &&
        t >= request.time - duration.value(24, 'h');
    }

    // ---------------------------------------------------------------- usuarios
    // Perfil y rol. Lo crea el administrador (el primer ADMIN se crea a mano en la consola).
    match /usuarios/{uid} {
      allow read: if autenticado() && (request.auth.uid == uid || esAdmin());
      allow create, update, delete: if esAdmin();
    }

    // ---------------------------------------------------------------- planteles
    // Geocerca (centro: GeoPoint, radioMetros, toleranciaMetros, toleranciaMinutos) y BSSIDs.
    match /planteles/{plantelId} {
      allow read: if autenticado() && (esAdmin() || mismoPlantel(plantelId));
      allow write: if esAdmin();
    }

    // ---------------------------------------------------------------- dispositivos
    // Vinculación del dispositivo (docId = installId generado por la app; no es la MAC).
    match /dispositivos/{installId} {
      function dd() {
        return request.resource.data;
      }

      allow read: if autenticado() && (resource.data.usuarioUid == request.auth.uid || esAdmin());

      // La app solicita la vinculación: alumnos quedan PENDIENTE; el resto de roles, ACTIVO.
      allow create: if autenticado()
        && dd().keys().hasOnly(['usuarioUid', 'alumnoId', 'rol', 'estado', 'clavePublica', 'modelo', 'creadoEn'])
        && dd().keys().hasAll(['usuarioUid', 'rol', 'estado', 'clavePublica', 'creadoEn'])
        && dd().usuarioUid == request.auth.uid
        && dd().rol == perfil().rol
        && dd().estado == (perfil().rol == 'ALUMNO' ? 'PENDIENTE' : 'ACTIVO')
        && (perfil().rol != 'ALUMNO' ||
            (dd().alumnoId is string &&
             get(/databases/$(database)/documents/alumnos/$(dd().alumnoId)).data.alumnoUid == request.auth.uid))
        && dd().creadoEn == request.time;

      // El administrador aprueba, revoca y asocia. (Los tokens FCM se registran en el backend.)
      allow update: if esAdmin();
      allow delete: if esAdmin();
    }

    // ---------------------------------------------------------------- alumnos
    // alumnoUid (nullable): cuenta del alumno; tutorUids: cuentas de sus tutores.
    match /alumnos/{alumnoId} {
      allow read: if autenticado() && (
        resource.data.alumnoUid == request.auth.uid ||
        request.auth.uid in resource.data.tutorUids ||
        esAdmin());
      allow write: if esAdmin();

      // Secreto TOTP del QR. Quién lo verifica (escáner o backend) se decide en la etapa del QR.
      match /secretos/{doc} {
        allow read: if autenticado() &&
          get(/databases/$(database)/documents/alumnos/$(alumnoId)).data.alumnoUid == request.auth.uid;
        allow write: if esAdmin();
      }
    }

    // ---------------------------------------------------------------- presencias
    // Presencia diaria en el plantel. docId = {alumnoId}_{yyyy-MM-dd}  (una por alumno y día).
    // PRESENTE se escribe desde el cliente. La ausencia vive en la colección `ausencias` (la escribe el backend).
    match /presencias/{presenciaId} {
      function datos() {
        return request.resource.data;
      }

      function llaveOk() {
        return presenciaId == datos().alumnoId + '_' + datos().fecha;
      }

      function camposPermitidos() {
        return datos().keys().hasOnly(['alumnoId', 'alumnoUid', 'plantelId', 'fecha', 'estado', 'metodo',
          'confianza', 'ubicacion', 'bssid', 'horaEntrada', 'horaSalida', 'relojConfiable', 'registradoPor',
          'tutorUids', 'dispositivoId', 'clientUuid', 'creadoEn']);
      }

      // El alumno registra su propia entrada con el dispositivo ACTIVO y dentro de la geocerca.
      function creaAlumno() {
        let a = get(/databases/$(database)/documents/alumnos/$(datos().alumnoId)).data;
        let p = get(/databases/$(database)/documents/planteles/$(a.plantelId)).data;
        let disp = get(/databases/$(database)/documents/dispositivos/$(datos().dispositivoId)).data;
        return autenticado()
          && datos().keys().hasAll(['alumnoId', 'alumnoUid', 'plantelId', 'fecha', 'estado', 'metodo',
               'confianza', 'ubicacion', 'horaEntrada', 'relojConfiable', 'tutorUids', 'dispositivoId',
               'clientUuid', 'creadoEn'])
          && a.alumnoUid == request.auth.uid && a.activo == true
          && datos().alumnoUid == request.auth.uid
          && datos().plantelId == a.plantelId
          && datos().tutorUids == a.tutorUids
          && datos().estado == 'PRESENTE'
          && (datos().metodo == 'GEOCERCA' || datos().metodo == 'GEOCERCA_WIFI')
          && datos().confianza == (datos().metodo == 'GEOCERCA_WIFI' ? 1 : 0)
          && datos().ubicacion is latlng
          && datos().ubicacion.distance(p.centro) <= p.radioMetros + p.toleranciaMetros
          && (datos().metodo == 'GEOCERCA' || (datos().bssid is string && datos().bssid in p.bssids))
          && horaRazonable(datos().horaEntrada)
          && datos().creadoEn == request.time
          && disp.estado == 'ACTIVO'
          && disp.alumnoId == datos().alumnoId
          && disp.usuarioUid == request.auth.uid;
      }

      // El administrador registra a un alumno sin teléfono escaneando su credencial QR.
      function creaAdmin() {
        let a = get(/databases/$(database)/documents/alumnos/$(datos().alumnoId)).data;
        return esAdmin()
          && datos().keys().hasAll(['alumnoId', 'alumnoUid', 'plantelId', 'fecha', 'estado', 'metodo',
               'confianza', 'horaEntrada', 'relojConfiable', 'tutorUids', 'registradoPor', 'clientUuid', 'creadoEn'])
          && datos().alumnoUid == a.alumnoUid
          && datos().plantelId == a.plantelId
          && datos().tutorUids == a.tutorUids
          && datos().estado == 'PRESENTE'
          && datos().metodo == 'QR_ADMIN'
          && datos().confianza == 1
          && datos().registradoPor == request.auth.uid
          && horaRazonable(datos().horaEntrada)
          && datos().creadoEn == request.time;
      }

      allow read: if autenticado() && (
        resource.data.alumnoUid == request.auth.uid ||
        request.auth.uid in resource.data.tutorUids ||
        esAdmin());

      // Se evalúa solo la rama que corresponde al método (evita errores por campos ausentes en la otra).
      allow create: if (camposPermitidos() && llaveOk() &&
          ((datos().metodo == 'QR_ADMIN' && creaAdmin()) ||
           (datos().metodo != 'QR_ADMIN' && creaAlumno())))
        || esAdmin();

      // El alumno solo registra su salida (puede actualizarla, pero nunca hacia atrás).
      allow update: if (autenticado()
          && resource.data.alumnoUid == request.auth.uid
          && soloCambia(['horaSalida'])
          && horaRazonable(request.resource.data.horaSalida)
          && request.resource.data.horaSalida >
               resource.data.get('horaSalida', resource.data.horaEntrada))
        || esAdmin();

      allow delete: if esAdmin();
    }

    // ---------------------------------------------------------------- ausencias
    // Las escribe el backend al vencer la tolerancia (docId = {alumnoId}_{yyyy-MM-dd}) y las borra si el
    // alumno registra su entrada después. Los clientes solo leen.
    match /ausencias/{ausenciaId} {
      allow read: if autenticado() &&
        (request.auth.uid in resource.data.tutorUids || esAdmin());
      allow write: if false;
    }

    // ---------------------------------------------------------------- justificantes
    // La evidencia (foto o video) vive en Azure Blob; aquí solo la ruta: {tutorUid}/{clientUuid}.jpg|mp4
    match /justificantes/{justificanteId} {
      function dj() {
        return request.resource.data;
      }

      function creaTutor() {
        let a = get(/databases/$(database)/documents/alumnos/$(dj().alumnoId)).data;
        return autenticado()
          && dj().keys().hasOnly(['alumnoId', 'plantelId', 'tutorUid', 'tipo', 'fechaInicio', 'fechaFin',
               'motivo', 'evidenciaBlobPath', 'evidenciaTipo', 'estado', 'clientUuid', 'creadoEn'])
          && dj().keys().hasAll(['alumnoId', 'plantelId', 'tutorUid', 'tipo', 'fechaInicio', 'fechaFin',
               'motivo', 'estado', 'clientUuid', 'creadoEn'])
          && request.auth.uid in a.tutorUids
          && dj().tutorUid == request.auth.uid
          && dj().plantelId == a.plantelId
          && dj().tipo in ['RECADO', 'CONSTANCIA_MEDICA']
          && dj().estado == 'PENDIENTE'
          && dj().motivo is string && dj().motivo.size() > 0 && dj().motivo.size() <= 500
          && dj().creadoEn == request.time
          && (!('evidenciaBlobPath' in dj()) ||
              (dj().evidenciaBlobPath is string &&
               dj().evidenciaBlobPath.matches('^' + request.auth.uid + '/[A-Za-z0-9._-]+$')));
      }

      allow read: if autenticado() &&
        (resource.data.tutorUid == request.auth.uid || esAdmin());

      allow create: if creaTutor();

      // El administrador acepta o rechaza (RF-P04).
      allow update: if esAdmin()
        && soloCambia(['estado', 'comentarioRevision', 'revisadoPor', 'revisadoEn'])
        && request.resource.data.estado in ['ACEPTADO', 'RECHAZADO']
        && request.resource.data.revisadoPor == request.auth.uid
        && request.resource.data.revisadoEn == request.time;
    }

    // ---------------------------------------------------------------- módulo académico
    // Grupos: incluye profesorUids y la lista de alumnos {id, nombre, matricula} que mantiene el ADMIN
    // (así el profesor obtiene su lista con una sola lectura).
    match /grupos/{grupoId} {
      allow read: if autenticado() &&
        (esAdmin() || request.auth.uid in resource.data.profesorUids);
      allow write: if esAdmin();
    }

    match /materias/{materiaId} {
      allow read: if autenticado();
      allow write: if esAdmin();
    }

    // Asignación grupo-materia-profesor.
    match /asignaciones/{asignacionId} {
      allow read: if autenticado() &&
        (resource.data.profesorUid == request.auth.uid || esAdmin());
      allow write: if esAdmin();
    }

    // Horarios por materia (RF-AD01): diaSemana 1-7, horaInicio/horaFin "HH:mm", aula.
    match /horarios/{horarioId} {
      allow read: if autenticado() &&
        (resource.data.profesorUid == request.auth.uid || esAdmin());
      allow write: if esAdmin();
    }

    // Sesión de clase y pase de lista. docId = {horarioId}_{yyyy-MM-dd}.
    // lista: { alumnoId: { estado: 'ASISTIO'|'NO_ASISTIO', justificada: bool } }  (una escritura por lista)
    match /sesiones/{sesionId} {
      function ds() {
        return request.resource.data;
      }

      function creaProfesor() {
        let h = get(/databases/$(database)/documents/horarios/$(ds().horarioId)).data;
        return autenticado()
          && ds().keys().hasOnly(['horarioId', 'asignacionId', 'grupoId', 'plantelId', 'profesorUid', 'fecha',
               'materiaNombre', 'grupoNombre', 'horaInicio', 'horaFin', 'estado', 'lista', 'creadoEn', 'actualizadoEn'])
          && ds().keys().hasAll(['horarioId', 'asignacionId', 'grupoId', 'plantelId', 'profesorUid', 'fecha',
               'estado', 'lista', 'creadoEn'])
          && sesionId == ds().horarioId + '_' + ds().fecha
          && h.profesorUid == request.auth.uid
          && ds().profesorUid == request.auth.uid
          && ds().plantelId == h.plantelId
          && ds().grupoId == h.grupoId
          && ds().asignacionId == h.asignacionId
          && ds().estado in ['ABIERTA', 'CERRADA']
          && ds().lista is map && ds().lista.size() <= 80
          && ds().creadoEn == request.time;
      }

      allow read: if autenticado() &&
        (resource.data.profesorUid == request.auth.uid || esAdmin());

      allow create: if creaProfesor() || esAdmin();

      // El profesor corrige mientras la sesión esté ABIERTA; después solo el ADMIN.
      allow update: if (autenticado()
          && resource.data.profesorUid == request.auth.uid
          && resource.data.estado == 'ABIERTA'
          && soloCambia(['lista', 'estado', 'actualizadoEn'])
          && request.resource.data.lista is map && request.resource.data.lista.size() <= 80
          && request.resource.data.actualizadoEn == request.time)
        || esAdmin();

      allow delete: if esAdmin();
    }

    // Calificaciones importadas de otro sistema (solo lectura para la app). docId = {asignacionId}_{alumnoId}
    match /calificaciones/{calificacionId} {
      allow read: if autenticado() && (resource.data.profesorUid == request.auth.uid || esAdmin());
      allow write: if esAdmin();
    }

    // ---------------------------------------------------------------- emergencias (RF-PF04)
    match /emergencias/{emergenciaId} {
      function de() {
        return request.resource.data;
      }

      allow read: if autenticado() && (resource.data.profesorUid == request.auth.uid || esAdmin());

      allow create: if esRol('PROFESOR')
        && de().keys().hasOnly(['profesorUid', 'plantelId', 'sesionId', 'mensaje', 'estado', 'creadoEn'])
        && de().keys().hasAll(['profesorUid', 'plantelId', 'mensaje', 'estado', 'creadoEn'])
        && de().profesorUid == request.auth.uid
        && de().plantelId == perfil().plantelId
        && de().estado == 'ABIERTA'
        && de().mensaje is string && de().mensaje.size() > 0 && de().mensaje.size() <= 500
        && de().creadoEn == request.time;

      allow update: if esAdmin()
        && soloCambia(['estado', 'atendidaPor', 'atendidaEn'])
        && request.resource.data.estado == 'ATENDIDA'
        && request.resource.data.atendidaPor == request.auth.uid
        && request.resource.data.atendidaEn == request.time;
    }

    // ---------------------------------------------------------------- notificaciones
    // Bandeja dentro de la app. Solo las escribe el backend (Admin SDK ignora estas reglas).
    match /notificaciones/{notificacionId} {
      allow read: if autenticado() && resource.data.destinatarioUid == request.auth.uid;
      allow update: if autenticado() && resource.data.destinatarioUid == request.auth.uid && soloCambia(['leida']);
      allow create, delete: if false;
    }

    // Todo lo demás permanece cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
